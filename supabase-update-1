-- 6. Verify child-record delete protection ---------------------------------
-- Catches BOTH the FK violation (current schema) and the soft-delete trigger
-- (raise_exception) if/when the audit block is re-added.
DO $$
BEGIN
    DELETE FROM customer WHERE custno = 'C0001';
    RAISE NOTICE 'UNEXPECTED: customer C0001 was deleted (it has sales)!';
EXCEPTION
    WHEN foreign_key_violation OR raise_exception THEN
        RAISE NOTICE 'Delete correctly blocked for customer C0001 (has sales).';
END $$;

