-- 1. priceHist --------------------------------------------------------------
-- NOTE: PK (prodCode, effDate) already covers the "price as-of" lookup via a
--       backward index scan — no separate index needed.
CREATE TABLE IF NOT EXISTS priceHist (
    prodCode VARCHAR(6)  NOT NULL REFERENCES product(prodCode),
    effDate  DATE        NOT NULL,
    price    DECIMAL(10,2) NOT NULL CHECK (price > 0),
    PRIMARY KEY (prodCode, effDate)
);

-- 2. Active views -----------------------------------------------------------
-- "active" here = has at least one sale. Using EXISTS (not DISTINCT + JOIN)
-- so the planner can short-circuit on the first matching child row.
CREATE OR REPLACE VIEW active_customers AS
SELECT c.*
FROM   customer c
WHERE  EXISTS (SELECT 1 FROM sales s
               WHERE s.custno = c.custno);

CREATE OR REPLACE VIEW active_products AS
SELECT p.*
FROM   product p
WHERE  EXISTS (SELECT 1 FROM salesDetail sd
               WHERE sd.prodCode = p.prodCode);

-- 3. Supporting indexes -----------------------------------------------------
-- FK columns are NOT auto-indexed in Postgres.
CREATE INDEX IF NOT EXISTS idx_customer_custname
    ON customer(custname);

CREATE INDEX IF NOT EXISTS idx_product_description
    ON product(description);

CREATE INDEX IF NOT EXISTS idx_sales_custno
    ON sales(custno);

CREATE INDEX IF NOT EXISTS idx_salesdetail_prodcode
    ON salesDetail(prodCode);

-- Trigram indexes for ILIKE '%...%' search (btree can't help leading wildcards)
CREATE EXTENSION IF NOT EXISTS pg_trgm;

CREATE INDEX IF NOT EXISTS idx_customer_custname_trgm
    ON customer USING gin (custname gin_trgm_ops);

CREATE INDEX IF NOT EXISTS idx_product_desc_trgm
    ON product  USING gin (description gin_trgm_ops);

-- 4. Current price as of a given date --------------------------------------
-- LANGUAGE sql STABLE (not plpgsql) so it can be inlined into larger queries.
-- Returns NULL if no price existed on or before p_as_of_date.
CREATE OR REPLACE FUNCTION get_price_as_of(
    p_prodCode    VARCHAR(6),
    p_as_of_date  DATE
) RETURNS DECIMAL(10,2)
LANGUAGE sql STABLE AS $$
    SELECT price
    FROM   priceHist
    WHERE  prodCode = p_prodCode
      AND  effDate <= p_as_of_date
    ORDER  BY effDate DESC
    LIMIT  1;
$$;

